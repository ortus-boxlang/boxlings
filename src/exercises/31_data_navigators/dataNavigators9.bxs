// Data Navigators Exercise 9 - Conditional Processing with ifPresent()
//
// Your task: Use conditional methods to process optional data.

var userProfile = {
    "name": "Alice",
    "email": "alice@example.com",
    "phone": "+1-555-0123"
}

var nav = dataNavigate( userProfile )

// TODO: Use ifPresent() to process email only if it exists
var processedEmail = ""
nav.ifPresent( "email", ( email ) -> {
    processedEmail = email.toUpperCase()
} )
assert processedEmail == "ALICE@EXAMPLE.COM" : "Expected uppercase email, got: #processedEmail#"

// TODO: Use ifPresent() to process phone only if it exists
var processedPhone = ""
nav.ifPresent( "phone", ( phone ) -> {
    processedPhone = phone.replace( "-", "" ).replace( "+", "" )
} )
assert processedPhone == "15550123" : "Expected cleaned phone, got: #processedPhone#"

// TODO: Use ifPresent() with a key that doesn't exist (should not execute)
var bio = ""
nav.ifPresent( "bio", ( b ) -> {
    bio = b
} )
assert bio == "" : "Expected empty string for missing bio"

// TODO: Use ifPresentOrElse() with a fallback
var notificationMethod = ""
nav.ifPresentOrElse(
    "sms",
    ( sms ) -> {
        notificationMethod = "SMS: #sms#"
    },
    () -> {
        notificationMethod = "Email: #nav.get('email')#"
    }
)
assert notificationMethod.contains( "Email" ) : "Expected email fallback, got: #notificationMethod#"

// TODO: Use ifPresentOrElse() when the key exists
var contactInfo = ""
nav.ifPresentOrElse(
    "email",
    ( email ) -> {
        contactInfo = "Contact: #email#"
    },
    () -> {
        contactInfo = "No email available"
    }
)
assert contactInfo == "Contact: alice@example.com" : "Expected email contact, got: #contactInfo#"

println( "Conditional processing successful!" )
println( "Email (processed): #processedEmail#" )
println( "Phone (cleaned): #processedPhone#" )
println( "Notification: #notificationMethod#" )
println( "Contact: #contactInfo#" )
